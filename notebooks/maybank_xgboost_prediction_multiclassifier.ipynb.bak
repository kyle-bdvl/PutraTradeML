       "      <th>sma20_to_sma50</th>\n",
       "      <th>adx_14</th>\n",
       "      <th>ret_mean_5</th>\n",
       "      <th>ret_std_5</th>\n",
       "      <th>ret_mean_10</th>\n",
       "      <th>ret_std_10</th>\n",
       "      <th>ret_mean_20</th>\n",
       "      <th>ret_std_20</th>\n",
       "      <th>volume_change</th>\n",
       "      <th>volume_sma_ratio</th>\n",
       "      <th>klci_rsi_14</th>\n",
       "      <th>klci_macd</th>\n",
       "      <th>klci_macd_signal</th>\n",
       "      <th>klci_macd_diff</th>\n",
       "      <th>klci_price_to_sma5</th>\n",
       "      <th>klci_price_to_sma10</th>\n",
       "      <th>klci_price_to_sma20</th>\n",
       "      <th>klci_price_to_sma50</th>\n",
       "      <th>klci_sma20_to_sma50</th>\n",
       "      <th>klci_adx_14</th>\n",
       "      <th>klci_ret_mean_5</th>\n",
       "      <th>klci_ret_std_5</th>\n",
       "      <th>klci_ret_mean_10</th>\n",
       "      <th>klci_ret_std_10</th>\n",
       "      <th>klci_ret_mean_20</th>\n",
