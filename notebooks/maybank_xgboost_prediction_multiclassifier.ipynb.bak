       "    <tr style=\"text-align: right;\">\n",
       "      <th></th>\n",
       "      <th>rsi_14</th>\n",
       "      <th>macd</th>\n",
       "      <th>macd_signal</th>\n",
       "      <th>macd_diff</th>\n",
